# Copy to .env (or set these as real environment variables) for local runs.
# See README.md "Deploying to Railway" for the production Railway Volume setup.

# TCP port the WebSocket + /health HTTP server listens on.
PORT=8787

# Max players allowed in a single lobby.
MAX_PLAYERS_PER_LOBBY=8

# Path to the SQLite database file used to persist lobby state so restarts
# don't lose active lobbies. Defaults to ./data/soullink.sqlite (relative to
# the server process's working directory) if unset.
#
# On Railway this MUST point inside a mounted Volume (e.g. /data/soullink.sqlite
# with the Volume mounted at /data) so the file survives redeploys/restarts.
# Do NOT point this at ephemeral container storage in production.
DB_PATH=./data/soullink.sqlite

# Discord OAuth application credentials. Create an app in the Discord
# Developer Portal and register the exact callback URL below as a redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/discord/callback
